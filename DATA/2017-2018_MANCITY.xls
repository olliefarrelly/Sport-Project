<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label="" data-stat="" colspan="4" class=" over_header center"></th><th></th> <th aria-label="" data-stat="header_playing" colspan="3" class=" over_header center group_start">Playing Time</th> <th aria-label="" data-stat="header_performance" colspan="8" class=" over_header center group_start">Performance</th> <th aria-label="" data-stat="header_per90" colspan="5" class=" over_header center group_start">Per 90 Minutes</th><th></th> </tr> <tr> <th aria-label="Player" data-stat="player" scope="col" class=" poptip sort_default_asc left">Player</th> <th aria-label="Nation" data-stat="nationality" scope="col" class=" poptip sort_default_asc center" data-tip="Nationality of the player.&lt;br&gt;First, we check our records in international play at senior level.&lt;br&gt;Then youth level.&lt;br&gt;Then citizenship presented on wikipedia.&lt;br&gt;Finally, we use their birthplace when available.">Nation</th> <th aria-label="Position" data-stat="position" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Position&lt;/strong&gt;&lt;br&gt;Position most commonly played by the player&lt;br&gt;GK - Goalkeepers&lt;br&gt;DF - Defenders&lt;br&gt;MF - Midfielders&lt;br&gt;FW - Forwards&lt;br&gt;FB - Fullbacks&lt;br&gt;LB - Left Backs&lt;br&gt;RB - Right Backs&lt;br&gt;CB - Center Backs&lt;br&gt;DM - Defensive Midfielders&lt;br&gt;CM - Central Midfielders&lt;br&gt;LM - Left Midfielders&lt;br&gt;RM - Right Midfielders&lt;br&gt;WM - Wide Midfielders&lt;br&gt;LW - Left Wingers&lt;br&gt;RW - Right Wingers&lt;br&gt;AM - Attacking Midfielders&lt;br&gt;">Pos</th> <th aria-label="Age" data-stat="age" scope="col" class=" poptip sort_default_asc center" data-tip="Age at season start&lt;br&gt;Given on August 1 for winter leagues&lt;br&gt;and February 1 for summer leagues.">Age</th> <th aria-label="Matches Played" data-stat="games" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Matches Played&lt;/strong&gt;&lt;br&gt;Matches Played by the player or squad">MP</th> <th aria-label="Starts" data-stat="games_starts" scope="col" class=" poptip center" data-tip="Game or games started by player" data-over-header="Playing Time">Starts</th> <th aria-label="Minutes" data-stat="minutes" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Minutes&lt;/strong&gt;&lt;br&gt;" data-over-header="Playing Time">Min</th> <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90" data-over-header="Playing Time">90s</th> <th aria-label="Goals" data-stat="goals" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Goals&lt;/strong&gt;&lt;br&gt;Goals scored or allowed" data-over-header="Performance">Gls</th> <th aria-label="Assists" data-stat="assists" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Assists&lt;/strong&gt;&lt;br&gt;Assists" data-over-header="Performance">Ast</th> <th aria-label="Goals + Assists" data-stat="goals_assists" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Goals + Assists&lt;/strong&gt;&lt;br&gt;Goals and Assists" data-over-header="Performance">G+A</th> <th aria-label="Non-Penalty Goals" data-stat="goals_pens" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Non-Penalty Goals&lt;/strong&gt;&lt;br&gt;Non-Penalty Goals" data-over-header="Performance">G-PK</th> <th aria-label="Penalty Kicks Made" data-stat="pens_made" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Made&lt;/strong&gt;&lt;br&gt;Penalty Kicks Made" data-over-header="Performance">PK</th> <th aria-label="Penalty Kicks Attempted" data-stat="pens_att" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Attempted&lt;/strong&gt;&lt;br&gt;Penalty Kicks Attempted" data-over-header="Performance">PKatt</th> <th aria-label="Yellow Cards" data-stat="cards_yellow" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Yellow Cards&lt;/strong&gt;&lt;br&gt;Yellow Cards" data-over-header="Performance">CrdY</th> <th aria-label="Red Cards" data-stat="cards_red" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Red Cards&lt;/strong&gt;&lt;br&gt;Red Cards" data-over-header="Performance">CrdR</th> <th aria-label="Goals/90" data-stat="goals_per90" scope="col" class=" poptip hide_non_quals center group_start" data-tip="&lt;strong&gt;Goals/90&lt;/strong&gt;&lt;br&gt;Goals Scored per 90 minutes&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Per 90 Minutes" data-filter="1" data-name="Goals/90">Gls</th> <th aria-label="Assists/90" data-stat="assists_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Assists/90&lt;/strong&gt;&lt;br&gt;Assists per 90 minutes&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Per 90 Minutes" data-filter="1" data-name="Assists/90">Ast</th> <th aria-label="Goals + Assists/90" data-stat="goals_assists_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Goals + Assists/90&lt;/strong&gt;&lt;br&gt;Goals and Assists per 90 minutes&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Per 90 Minutes" data-filter="1" data-name="Goals + Assists/90">G+A</th> <th aria-label="Non-Penalty Goals/90" data-stat="goals_pens_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Non-Penalty Goals/90&lt;/strong&